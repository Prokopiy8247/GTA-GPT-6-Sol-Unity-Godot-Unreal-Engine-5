!.env.example
*.key
*.pem
*.p12
*.pfx
*.keystore
*.jks
*.mobileprovision
export_credentials.cfg
/.godot/export_credentials.cfg

# OS/editor files.
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
